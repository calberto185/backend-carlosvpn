# --- Carlos VPN backend ---
PORT=3000
PUBLIC_BASE_URL=https://vpn.carlosvm.me
BRAND_NAME=Carlos VPN
BRAND_NAME_RU=КарлосВПН
SUPPORT_URL=https://t.me/CAMBIAR_ESTO
# Opcional: botón de web en Happ. Sin comentarios en la misma línea.
PROFILE_WEB_URL=

MONGO_URI=mongodb://localhost:27017
MONGO_DB=carlosvpn

# 32 bytes en hex (64 caracteres). Genera uno con:  openssl rand -hex 32
ENCRYPTION_KEY=

# Agregador
UPSTREAM_TIMEOUT_MS=8000
SUB_UPDATE_INTERVAL_HOURS=6
RATE_LIMIT_PER_MIN=30

# Idioma por defecto si el usuario no eligió ninguno: es, en, ru, zh, ar, hi, bn
DEFAULT_LOCALE=es

# Duración de la sesión del panel de gestión, en horas (por defecto 12)
SESSION_TTL_HOURS=12
